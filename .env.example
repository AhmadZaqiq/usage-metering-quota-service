# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://app:app_secret@localhost:5432/usage_metering

# Business limits
MAX_UNITS_PER_REQUEST=10000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Redis (optional - for distributed rate limiting across instances)
# If not set, falls back to in-memory rate limiting
REDIS_URL=redis://redis:6379

# Bootstrap (optional - for initial account/key creation)
BOOTSTRAP_ACCOUNT_NAME=Acme Corp
BOOTSTRAP_API_KEY_NAME=Default Key