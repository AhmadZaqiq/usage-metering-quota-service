# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://app:app_secret@localhost:5432/usage_metering

# Business limits
MAX_UNITS_PER_REQUEST=10000

# Rate limiting (in-process per Node.js instance: counters reset on restart
# and are not shared across replicas)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Trust proxy (set to true when behind a reverse proxy/load balancer)
TRUST_PROXY=false

# Bootstrap (optional - for initial account/key creation)
BOOTSTRAP_ACCOUNT_NAME=Acme Corp
BOOTSTRAP_API_KEY_NAME=Default Key

# Operator credential for POST /accounts (account provisioning).
# Minimum 16 characters. Leave unset to disable the endpoint entirely (404).
# OPERATOR_TOKEN=change-me-to-a-long-random-string