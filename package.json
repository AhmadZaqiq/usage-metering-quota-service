{
  "name": "usage-metering-quota-service",
  "version": "1.0.0",
  "description": "Backend-only Usage Metering & Quota Service",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p .config/tsconfig.json && node -e \"require('fs').cpSync('src/db/sql','dist/db/sql',{recursive:true})\"",
    "start": "node dist/main.js",
    "lint": "eslint src --ext .ts --config .config/eslint.config.mjs",
    "format": "prettier --write --config .config/prettier.config.mjs \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p .config/tsconfig.json",
    "test": "vitest run --config .config/vitest.config.ts",
    "test:watch": "vitest --config .config/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config .config/vitest.config.ts",
    "db:generate": "drizzle-kit generate --config .config/drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio --config .config/drizzle.config.ts",
    "bootstrap": "tsx src/scripts/bootstrap.ts",
    "bootstrap:loadtest": "tsx src/scripts/bootstrap-loadtest.ts",
    "loadtest": "tsx src/scripts/loadtest.ts",
    "client": "tsx src/scripts/client.ts"
  },
  "keywords": [
    "usage-metering",
    "quota",
    "api-gateway",
    "backend"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "drizzle-orm": "^0.33.0",
    "express": "^4.19.2",
    "ioredis": "^6.0.0",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.9",
    "autocannon": "^7.14.0",
    "drizzle-kit": "^0.24.0",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
